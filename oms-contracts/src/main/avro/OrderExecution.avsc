{
  "namespace": "org.example.common.model.msg",
  "type": "record",
  "doc": "One fill with the order it changed, as of that change. Published on the order-executions topic in the fill's transaction, keyed by rootOrderId, so a consumer needs no lookup. Deduplicate on (orderId, execId, orderVersion): execId is unique per order only.",
  "name": "OrderExecution",
  "fields": [
    {
      "name": "execId",
      "type": ["null", "string"],
      "doc": "Execution identifier, unique per order.",
      "default": null
    },
    {
      "name": "lastQty",
      "doc": "Quantity filled by this execution.",
      "type": ["null", {"type": "bytes", "logicalType": "decimal", "precision": 18, "scale": 4}],
      "default": null
    },
    {
      "name": "lastPx",
      "doc": "Price of this execution.",
      "type": ["null", {"type": "bytes", "logicalType": "decimal", "precision": 18, "scale": 4}],
      "default": null
    },
    {
      "name": "execType",
      "type": ["null", "string"],
      "doc": "Execution type.",
      "default": null
    },
    {
      "name": "lastCapacity",
      "type": ["null", "string"],
      "doc": "Capacity in which the execution was made.",
      "default": null
    },
    {
      "name": "lastMkt",
      "type": ["null", "string"],
      "doc": "Market of execution.",
      "default": null
    },
    {
      "name": "transactTime",
      "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}],
      "doc": "Time of the execution.",
      "default": null
    },
    {
      "name": "orderId",
      "type": ["null", "string"],
      "doc": "The order this execution filled.",
      "default": null
    },
    {
      "name": "rootOrderId",
      "type": ["null", "string"],
      "doc": "Root of the order's tree; the order's own id when it has no root. The record's Kafka key.",
      "default": null
    },
    {
      "name": "parentOrderId",
      "type": ["null", "string"],
      "doc": "Direct parent of the order in its tree, if any.",
      "default": null
    },
    {
      "name": "leg",
      "type": ["null", "string"],
      "doc": "The order's leg (CLI or MKT), if set.",
      "default": null
    },
    {
      "name": "clOrdId",
      "type": ["null", "string"],
      "doc": "Client order id.",
      "default": null
    },
    {
      "name": "sessionId",
      "type": ["null", "string"],
      "doc": "Trading session of the client order.",
      "default": null
    },
    {
      "name": "account",
      "type": ["null", "string"],
      "doc": "Account the order is for.",
      "default": null
    },
    {
      "name": "side",
      "type": ["null", "org.example.common.model.msg.Side"],
      "default": null
    },
    {
      "name": "symbol",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "securityId",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "ordType",
      "type": ["null", "org.example.common.model.msg.OrdType"],
      "default": null
    },
    {
      "name": "price",
      "doc": "Order limit price.",
      "type": ["null", {"type": "bytes", "logicalType": "decimal", "precision": 18, "scale": 4}],
      "default": null
    },
    {
      "name": "orderQty",
      "type": ["null", {"type": "bytes", "logicalType": "decimal", "precision": 18, "scale": 4}],
      "default": null
    },
    {
      "name": "settlCurrency",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "exDestination",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "cumQty",
      "doc": "Order's cumulative executed quantity after this execution.",
      "type": ["null", {"type": "bytes", "logicalType": "decimal", "precision": 18, "scale": 4}],
      "default": null
    },
    {
      "name": "leavesQty",
      "doc": "Order's remaining open quantity after this execution.",
      "type": ["null", {"type": "bytes", "logicalType": "decimal", "precision": 18, "scale": 4}],
      "default": null
    },
    {
      "name": "avgPx",
      "doc": "Average price across the order's fills. Not currently computed by oms-core; null until it is.",
      "type": ["null", {"type": "bytes", "logicalType": "decimal", "precision": 18, "scale": 4}],
      "default": null
    },
    {
      "name": "state",
      "type": ["null", "org.example.common.model.msg.State"],
      "doc": "Order state after this execution.",
      "default": null
    },
    {
      "name": "orderVersion",
      "type": ["null", "long"],
      "doc": "The order's event-log version this fill produced (order_events.version); equals the eventId of the order message of the same change.",
      "default": null
    },
    {
      "name": "tradeDate",
      "type": ["null", {"type": "int", "logicalType": "date"}],
      "doc": "UTC calendar date of transactTime, or of the fill's processing time when it has none.",
      "default": null
    }
  ]
}
