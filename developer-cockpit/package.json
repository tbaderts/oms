{
  "name": "developer-cockpit",
  "version": "0.1.0",
  "description": "Developer Cockpit - Unified workbench for spec-driven development",
  "main": "dist/main/index.js",
  "scripts": {
    "predev": "node scripts/copy-excalidraw-assets.mjs",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5180 && tsc -p tsconfig.node.json && cross-env DEV_SERVER=true electron .",
    "start": "electron .",
    "prebuild": "node scripts/copy-excalidraw-assets.mjs",
    "build": "tsc -p tsconfig.node.json && vite build",
    "package": "npm run build && electron-builder",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --exclude \"**/*.perf.test.ts\" && vitest run .perf.test",
    "test:e2e": "npm run build && playwright test -c e2e/playwright.config.ts",
    "check:storyboards": "tsc -p tsconfig.node.json && node dist/main/storyboards/cli/checkStoryboards.js"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@xmldom/xmldom": "0.9.12",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.475.0",
    "mermaid": "^12.2.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "rehype-highlight": "^7.0.2",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "^4.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "roughjs": "4.6.6",
    "simple-git": "^3.27.0",
    "tailwind-merge": "^3.0.2",
    "unified": "11.0.5",
    "ws": "^8.18.0",
    "yaml": "2.9.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.3"
  }
}
