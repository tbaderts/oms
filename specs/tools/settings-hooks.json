{
  "permissions": {
    "allow": [
      "Bash(curl:*)",
      "Bash(node specs/tools/spec.mjs:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/specs/tools/spec.mjs\" hook pre-tool"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/specs/tools/spec.mjs\" hook stop"
          }
        ]
      }
    ]
  }
}
