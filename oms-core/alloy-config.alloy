// Grafana Alloy — the single telemetry agent of the OMS LGTM stack (SPEC-0032).
// Bind-mounted by docker-compose.yml at /etc/alloy/config.alloy.
// OTLP in on 4317 (gRPC) / 4318 (HTTP), published on the host too. The Spring services
// push traces, metrics and logs over OTLP/HTTP (SPEC-0033): compose services to
// http://alloy:4318, host-native runs to http://localhost:4318 (OTLP_ENDPOINT, with
// OTLP_EXPORT_ENABLED=true). Traces go to Tempo, metrics to Mimir, logs to Loki.
// Infrastructure containers, which do not speak OTLP, still have their stdout shipped.

// ---- OTLP in ----
otelcol.receiver.otlp "default" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		metrics = [otelcol.processor.batch.default.input]
		logs    = [otelcol.processor.batch.default.input]
		traces  = [otelcol.processor.batch.default.input]
	}
}

otelcol.processor.batch "default" {
	output {
		metrics = [otelcol.exporter.otlphttp.mimir.input]
		logs    = [otelcol.exporter.otlphttp.loki.input]
		traces  = [otelcol.exporter.otlp.tempo.input]
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo:4317"

		tls {
			insecure = true
		}
	}
}

// Native OTLP ingestion: Mimir keeps metric names as sent
otelcol.exporter.otlphttp "mimir" {
	client {
		endpoint = "http://mimir:9009/otlp"
	}
}

// Native OTLP ingestion (needs allow_structured_metadata in loki-config.yml)
otelcol.exporter.otlphttp "loki" {
	client {
		endpoint = "http://loki:3100/otlp"
	}
}

// ---- container logs of this compose project (Promtail's former job) ----
// Read through the read-only /var/run/docker.sock mount; the label filter
// restricts discovery to compose services.
discovery.docker "compose" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "15s"

	filter {
		name   = "label"
		values = ["com.docker.compose.service"]
	}
}

discovery.relabel "compose" {
	targets = []

	// The OMS services send their logs over OTLP (SPEC-0033); shipping their stdout too
	// would put every line in Loki twice.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "oms-core|streaming-service|exchange-simulator|mcp-server"
		action        = "drop"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "compose_service"
	}

	rule {
		source_labels = ["__meta_docker_container_log_stream"]
		target_label  = "stream"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		target_label  = "docker_name"
	}
}

loki.source.docker "compose" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.compose.targets
	relabel_rules = discovery.relabel.compose.rules
	forward_to    = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
