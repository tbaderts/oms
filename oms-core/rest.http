###
# Metamodel API endpoints

# Get all metamodel metadata
GET http://localhost:8090/api/v1/metamodel HTTP/1.1
content-type: application/json

###
# Get Order metamodel metadata
GET http://localhost:8090/api/v1/metamodel/Order HTTP/1.1
content-type: application/json

###
# Get Execution metamodel metadata
GET http://localhost:8090/api/v1/metamodel/Execution HTTP/1.1
content-type: application/json

###
# List all available entities
GET http://localhost:8090/api/v1/metamodel/entities HTTP/1.1
content-type: application/json

###
# Metamodel health check
GET http://localhost:8090/api/v1/metamodel/health HTTP/1.1
content-type: application/json
###
# Lifecycle commands (SPEC-0001). With the exchange simulator running, only the cancel request is
# sent by hand; the simulator answers with OrderCancelCmd or OrderCancelRejectCmd.

# Request cancellation of a resting order's open quantity (FIX 35=F)
POST http://localhost:8090/api/command/execute HTTP/1.1
content-type: application/json

{"type":"OrderCancelRequestCmd","version":"1.0.0","orderId":"<orderId>","commandId":"<unique id; a repeat is refused as duplicate>"}

###
# Market confirms a cancel (ExecType=4)
POST http://localhost:8090/api/command/execute HTTP/1.1
content-type: application/json

{"type":"OrderCancelCmd","version":"1.0.0","orderId":"<orderId>","text":"Cancelled on request","commandId":"<orderId>-CXL-1"}

###
# Market refuses a cancel request (35=9)
POST http://localhost:8090/api/command/execute HTTP/1.1
content-type: application/json

{"type":"OrderCancelRejectCmd","version":"1.0.0","orderId":"<orderId>","text":"Too late to cancel","commandId":"<orderId>-CXLREJ-1"}

###
# Market rejects an order (ExecType=8)
POST http://localhost:8090/api/command/execute HTTP/1.1
content-type: application/json

{"type":"OrderRejectCmd","version":"1.0.0","orderId":"<orderId>","text":"Unknown symbol ZZZZ","commandId":"<orderId>-REJ-1"}

###
# A fill (ExecType=F)
POST http://localhost:8090/api/command/execute HTTP/1.1
content-type: application/json

{"type":"ExecutionCreateCmd","version":"1.0.0","execution":{"execId":"<orderId>-F1","orderId":"<orderId>","lastQty":100,"lastPx":170.00,"execType":"F","lastMkt":"XSIM"}}
